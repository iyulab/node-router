{
  "name": "@iyulab/router",
  "version": "0.25.1",
  "description": "A modern client-side router for web applications with support for Lit and React components",
  "keywords": [
    "lit",
    "react",
    "router",
    "routing",
    "spa",
    "navigation",
    "client-side"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-router.git"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "customElements": "./dist/custom-elements.json",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/*.js",
    "./src/components/*.ts",
    "./src/index.ts",
    "./src/react.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js"
    }
  },
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "test": "vitest run --project=unit --project=browser",
    "test:webkit": "vitest run --project=webkit",
    "analyze": "cem analyze",
    "build": "npm run typecheck && npm run lint && vite build && npm run analyze",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "urlpattern-polyfill": "^10.1.0"
  },
  "peerDependencies": {
    "@iyulab/components": ">=1.41.0",
    "@lit/react": "^1.0.8",
    "lit": "^3.3.3",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@iyulab/components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@iyulab/components": "^3.0.0",
    "@lit/react": "^1.0.8",
    "@microsoft/api-extractor": "^7.58.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.0",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^21.0.1",
    "lit": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.0"
  }
}
